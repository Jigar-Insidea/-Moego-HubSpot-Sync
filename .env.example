# Server Environment Configuration
NODE_ENV=production
PORT=10000

# MoeGo API Configuration
MOEGO_API_KEY_B64=your_moego_base64_api_key_here
MOEGO_BASE_URL=https://openapi.moego.pet
MOEGO_COMPANY_ID=copaRXx
MOEGO_BUSINESS_IDS=bizT2HX,bizVaEO

# HubSpot API Configuration
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here
HUBSPOT_PORTAL_ID=245256880
HUBSPOT_PIPELINE_ID=default

# Sync Schedule Configuration
# Cron pattern: Runs every 5 minutes (Concurrency-locked to prevent overlap)
CRON_RECONCILE_SCHEDULE="*/5 * * * *"

# Storage Path for Sync State
SYNC_STATE_DB_PATH=/var/data/sync_state.json
