{
  "name": "moego-hubspot-integration",
  "version": "1.0.0",
  "description": "Production-grade synchronization middleware connecting MoeGo POS/CRM and HubSpot CRM for Vera's Posh Paws",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=1024 src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/**/*.test.js",
    "sync:full": "node --max-old-space-size=1024 scripts/runFullBackfill.js",
    "sync:reconcile": "node scripts/runReconciliation.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "moego",
    "hubspot",
    "integration",
    "crm",
    "sync",
    "render"
  ],
  "author": "INSIDEA Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "winston": "^3.17.0"
  }
}
